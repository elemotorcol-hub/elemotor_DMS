# ─── Application ─────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ─── MySQL (Docker) ───────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=db_elemotor

# ─── Prisma ───────────────────────────────────────────────────────────────────
DATABASE_URL="mysql://root:your_password@localhost:3306/db_elemotor"

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_strong_random_secret_in_production
JWT_REFRESH_SECRET=change_this_to_a_different_strong_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ─── Mail (Nodemailer) ────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_email_app_password
MAIL_FROM="EleMotor DMS <noreply@elemotor.co>"

# ─── OTP ──────────────────────────────────────────────────────────────────────
# Usar "mock" en desarrollo (solo loguea en consola, no envía SMS real)
OTP_PROVIDER=mock
OTP_EXPIRES_MINUTES=5

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
