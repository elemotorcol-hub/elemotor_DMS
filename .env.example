# ─── Application ─────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ─── MySQL ────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_elemotor

# ─── Prisma ───────────────────────────────────────────────────────────────────
DATABASE_URL="mysql://root:@localhost:3306/db_elemotor"

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_strong_random_secret_in_production
JWT_REFRESH_SECRET=change_this_to_a_different_strong_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ─── Mail (Nodemailer / Gmail SMTP) ───────────────────────────────────────────
# Configuración para envío de correos via Gmail con STARTTLS (puerto 587).
#
# IMPORTANTE: MAIL_PASS debe ser una Contraseña de Aplicación de Google,
# NO la contraseña normal de la cuenta de Gmail.
#
# Cómo obtener la Contraseña de Aplicación:
#   1. Ir a https://myaccount.google.com/security
#   2. Activar "Verificación en 2 pasos" (si no está activa).
#   3. En el buscador de la cuenta Google escribir "Contraseñas de aplicación".
#   4. Crear una nueva entrada: Aplicación = "Correo", Dispositivo = "Otro" (ej. EleMotor DMS).
#   5. Copiar la contraseña de 16 caracteres generada (sin espacios) y pegarla en MAIL_PASS.
#
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu_cuenta@gmail.com
MAIL_PASS=abcd efgh ijkl mnop
# ^ Contraseña de Aplicación de 16 caracteres (con o sin espacios, nodemailer los ignora)
MAIL_FROM="EleMotor DMS <tu_cuenta@gmail.com>"

# Dirección a la que llegan las notificaciones internas (citas, cotizaciones, etc.)
APPOINTMENTS_NOTIFY_EMAIL=equipo@elemotor.co

# ─── OTP ──────────────────────────────────────────────────────────────────────
# Usar "mock" en desarrollo (solo loguea en consola, no envía SMS real)
OTP_PROVIDER=mock
OTP_EXPIRES_MINUTES=5

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Webhooks ─────────────────────────────────────────────────────────────────
ORDER_WEBHOOK_URL=
QUOTE_WEBHOOK_URL=
